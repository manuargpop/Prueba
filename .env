# Archivo de configuración de entorno
# Agrega tu API key de Alibaba Model Studio aquí
ALIBABA_API_KEY='aqui va la apikey'
# Para desarrollo local con certificados auto-firmados, puedes deshabilitar la verificación SSL:
ALIBABA_VERIFY_SSL=false
# O usar un bundle CA de confianza:
# REQUESTS_CA_BUNDLE=C:/ruta/a/tu/ca-bundle.pem
# Modelo Alibaba Qwen. Cambia aquí si tu cuenta tiene acceso a otro modelo.
ALIBABA_MODEL=qwen3.7-plus
# Base URL para el endpoint compatible con OpenAI de Alibaba
ALIBABA_BASE_URL='y aqui el link de la apikey'